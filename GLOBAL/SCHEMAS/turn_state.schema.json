{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnStateSchema",
  "description": "Deterministic public state for a live campaign (GAMEPLAY/status.json). GM-private facts must never be stored here.",
  "type": "object",
  "required": [
    "schema_version",
    "campaign_id",
    "turn",
    "timeline",
    "progression",
    "scene_anchor",
    "public_state",
    "clocks"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Recommended: 2 for the consequence-and-clocks contract."
    },
    "campaign_id": {
      "type": "string"
    },
    "turn": {
      "type": "integer",
      "minimum": 1
    },
    "timeline": {
      "type": "string"
    },
    "progression": {
      "type": "object",
      "required": [
        "checkpoint_tokens",
        "checkpoint_max"
      ]
    },
    "purse": {
      "type": "object",
      "properties": {
        "credits": {
          "type": "integer"
        },
        "platinum": {
          "type": "integer"
        },
        "gold": {
          "type": "integer"
        },
        "silver": {
          "type": "integer"
        },
        "copper": {
          "type": "integer"
        },
        "display": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "scene_anchor": {
      "type": "object",
      "required": [
        "location",
        "context",
        "time"
      ],
      "properties": {
        "location": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "time": {
          "type": "string"
        }
      }
    },
    "public_state": {
      "type": "object",
      "description": "Facts currently known to the protagonist.",
      "properties": {
        "flags": {
          "type": "object"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_threads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "clocks": {
      "type": "array",
      "description": "Known or suspected pressures. Never expose gm_private clocks here.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "current",
          "max",
          "visibility"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "current": {
            "type": "integer",
            "minimum": 0
          },
          "max": {
            "type": "integer",
            "minimum": 1
          },
          "visibility": {
            "type": "string",
            "enum": [
              "known",
              "suspected"
            ]
          },
          "advance_trigger": {
            "type": "string"
          }
        }
      }
    },
    "transaction_id": {
      "type": "string"
    },
    "pacing_state": {
      "type": "object",
      "description": "Persistent adaptive narrative focus and pacing controller state.",
      "properties": {
        "scene_type": {
          "type": "string",
          "description": "Current narrative scene type (e.g. conversation, conflict, exploration, downtime, travel, routine)."
        },
        "scene_objective": {
          "type": "string",
          "description": "Immediate tactical or narrative goal of the scene."
        },
        "narrative_intensity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Narrative intensity level from 1 (quiet/routine) to 5 (life-or-death/climax)."
        },
        "zoom_level": {
          "type": "string",
          "enum": [
            "detailed_scene",
            "short_summary",
            "montage",
            "time_skip"
          ],
          "description": "Camera focal depth and time resolution."
        },
        "elapsed_time_minutes": {
          "type": "integer",
          "minimum": 0,
          "description": "Explicit total in-game elapsed time in minutes."
        },
        "timeline_stamp": {
          "type": "string",
          "description": "Diegetic calendar or clock timestamp."
        },
        "active_conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of active immediate conflicts."
        },
        "unresolved_intentions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Player declarations or scene intentions that have not yet reached closure."
        },
        "current_location": {
          "type": "string",
          "description": "Current diegetic location of the protagonist."
        },
        "pending_decisions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Immediate forks or choices requiring resolution."
        },
        "pacing_profile": {
          "type": "string",
          "enum": [
            "slow",
            "balanced",
            "fast"
          ],
          "description": "Macro progression pacing profile."
        },
        "scheduled_events": {
          "type": "array",
          "description": "Clock events scheduled to fire at specific elapsed time thresholds.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "trigger_time_minutes",
              "description",
              "fired"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "trigger_time_minutes": {
                "type": "integer",
                "minimum": 0
              },
              "description": {
                "type": "string"
              },
              "fired": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}